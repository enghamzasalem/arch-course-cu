        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n%% =========================\n%% BEFORE: VM MONOLITH\n%% =========================\nsubgraph BEFORE[\&quot;Before: VM-based Monolith\&quot;]\n    C[\&quot;Web / Mobile Clients\&quot;]\n    VM[\&quot;Monolithic CityBite API (VMs)\&quot;]\n    DB[\&quot;PostgreSQL (Single Managed Instance)\&quot;]\n    FS[\&quot;Local Disk Storage (/var/citybite/uploads)\&quot;]\n\n    C --&gt; VM\n    VM --&gt; DB\n    VM --&gt; FS\nend\n\n%% =========================\n%% AFTER: KUBERNETES ARCHITECTURE\n%% =========================\nsubgraph AFTER[\&quot;After: Kubernetes (Containerized CityBite)\&quot;]\n    C2[\&quot;Web / Mobile Clients\&quot;]\n    ING[\&quot;Ingress Controller\&quot;]\n    SVC[\&quot;Kubernetes Service\&quot;]\n    API[\&quot;CityBite API Pods (Deployment)\&quot;]\n    WORK[\&quot;Background Worker Pods\&quot;]\n    DB2[\&quot;Managed PostgreSQL (RDS)\&quot;]\n    S3[\&quot;Object Storage (S3)\&quot;]\n\n    C2 --&gt; ING\n    ING --&gt; SVC\n    SVC --&gt; API\n\n    API --&gt; DB2\n    API --&gt; S3\n    API --&gt; WORK\n    WORK --&gt; DB2\nend\n\n%% =========================\n%% LEGEND\n%% =========================\nsubgraph LEGEND[\&quot;Legend\&quot;]\n    L1[\&quot;Clients\&quot;]\n    L2[\&quot;Application Layer (Pods)\&quot;]\n    L3[\&quot;Database (External Managed Service)\&quot;]\n    L4[\&quot;File Storage (Object Storage - S3)\&quot;]\n\n    L1 --&gt; L2\n    L2 --&gt; L3\n    L2 --&gt; L4\nend&quot;&#xa;}" id="99sY07ELzXBQrzN3kfXi-1">
