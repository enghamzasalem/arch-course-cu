<mxfile host="app.diagrams.net">
  <diagram id="seq-async" name="Async Pipeline Sequence">
    <mxGraphModel dx="1422" dy="762" grid="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <!-- Swimlane participants -->
        <mxCell id="p1" value="Client" style="shape=mxgraph.sequence.lifeline;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="50" width="100" height="500" as="geometry"/></mxCell>
        <mxCell id="p2" value="API Gateway" style="shape=mxgraph.sequence.lifeline;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="200" y="50" width="100" height="500" as="geometry"/></mxCell>
        <mxCell id="p3" value="Job Queue" style="shape=mxgraph.sequence.lifeline;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="340" y="50" width="100" height="500" as="geometry"/></mxCell>
        <mxCell id="p4" value="Orchestrator" style="shape=mxgraph.sequence.lifeline;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="480" y="50" width="100" height="500" as="geometry"/></mxCell>
        <mxCell id="p5" value="Extractor" style="shape=mxgraph.sequence.lifeline;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="620" y="50" width="100" height="500" as="geometry"/></mxCell>
        <mxCell id="p6" value="Storage" style="shape=mxgraph.sequence.lifeline;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="760" y="50" width="100" height="500" as="geometry"/></mxCell>
        <mxCell id="p7" value="Notifier" style="shape=mxgraph.sequence.lifeline;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="900" y="50" width="100" height="500" as="geometry"/></mxCell>
        <!-- Messages as labeled edges -->
        <mxCell id="m1" value="1. POST /pipeline/jobs {file, webhook_url}" style="endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry x="110" y="130" width="90" height="20" as="geometry"><Array as="points"><mxPoint x="110" y="130"/><mxPoint x="200" y="130"/></Array></mxGeometry></mxCell>
        <mxCell id="m2" value="2. validate request" style="endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="250" y="155"/><mxPoint x="270" y="155"/></Array></mxGeometry></mxCell>
        <mxCell id="m3" value="3. publish(job_id, doc_id, storage_url)" style="endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="250" y="180"/><mxPoint x="340" y="180"/></Array></mxGeometry></mxCell>
        <mxCell id="m4" value="4. 202 {job_id}" style="endArrow=block;endFill=1;dashed=1;strokeColor=#888;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="200" y="205"/><mxPoint x="110" y="205"/></Array></mxGeometry></mxCell>
        <mxCell id="m5" value="5. dequeue, activate worker" style="endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="340" y="240"/><mxPoint x="480" y="240"/></Array></mxGeometry></mxCell>
        <mxCell id="m6" value="6. validate(doc_id) -- direct call" style="endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="480" y="270"/><mxPoint x="510" y="270"/></Array></mxGeometry></mxCell>
        <mxCell id="m7" value="7. extract(doc_id, options)" style="endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="480" y="300"/><mxPoint x="620" y="300"/></Array></mxGeometry></mxCell>
        <mxCell id="m8" value="8. {text, confidence}" style="endArrow=block;endFill=1;dashed=1;strokeColor=#888;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="620" y="340"/><mxPoint x="480" y="340"/></Array></mxGeometry></mxCell>
        <mxCell id="m9" value="9. classify(text) -- direct call" style="endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="480" y="370"/><mxPoint x="510" y="370"/></Array></mxGeometry></mxCell>
        <mxCell id="m10" value="10. store(doc_id, text, label)" style="endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="480" y="400"/><mxPoint x="760" y="400"/></Array></mxGeometry></mxCell>
        <mxCell id="m11" value="11. {file_url, result_url}" style="endArrow=block;endFill=1;dashed=1;strokeColor=#888;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="760" y="425"/><mxPoint x="480" y="425"/></Array></mxGeometry></mxCell>
        <mxCell id="m12" value="12. publish(job.complete, webhook_url)" style="endArrow=block;endFill=1;dashed=1;strokeColor=#d79b00;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="480" y="455"/><mxPoint x="900" y="455"/></Array></mxGeometry></mxCell>
        <mxCell id="m13" value="13. POST webhook {status:done, result}" style="endArrow=block;endFill=1;dashed=1;strokeColor=#d79b00;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="900" y="490"/><mxPoint x="110" y="490"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
