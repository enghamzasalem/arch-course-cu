        <mxCell id="p1" value="Client" style="shape=mxgraph.sequence.lifeline;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="50" width="100" height="520" as="geometry"/></mxCell>
        <mxCell id="p2" value="API Gateway" style="shape=mxgraph.sequence.lifeline;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="210" y="50" width="100" height="520" as="geometry"/></mxCell>
        <mxCell id="p3" value="Task API v1" style="shape=mxgraph.sequence.lifeline;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="360" y="50" width="100" height="520" as="geometry"/></mxCell>
        <mxCell id="p4" value="Task API v2" style="shape=mxgraph.sequence.lifeline;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="510" y="50" width="100" height="520" as="geometry"/></mxCell>
        <mxCell id="p5" value="Task Store" style="shape=mxgraph.sequence.lifeline;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="670" y="50" width="100" height="520" as="geometry"/></mxCell>
        <!-- Phase 1: v1 calls -->
        <mxCell id="m1" value="1. GET /v1/tasks" style="endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="110" y="130"/><mxPoint x="210" y="130"/></Array></mxGeometry></mxCell>
        <mxCell id="m2" value="2. route to v1" style="endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="210" y="150"/><mxPoint x="360" y="150"/></Array></mxGeometry></mxCell>
        <mxCell id="m3" value="3. SELECT tasks" style="endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="360" y="170"/><mxPoint x="670" y="170"/></Array></mxGeometry></mxCell>
        <mxCell id="m4" value="4. 200 OK + Deprecation: true, Sunset: date" style="endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="360" y="200"/><mxPoint x="110" y="200"/></Array></mxGeometry></mxCell>
        <!-- Phase 2: client migrates to v2 -->
        <mxCell id="m5" value="5. GET /v2/tasks + X-Client-Id (client migrated)" style="endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="110" y="260"/><mxPoint x="210" y="260"/></Array></mxGeometry></mxCell>
        <mxCell id="m6" value="6. route to v2" style="endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="210" y="280"/><mxPoint x="510" y="280"/></Array></mxGeometry></mxCell>
        <mxCell id="m7" value="7. SELECT tasks" style="endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="510" y="300"/><mxPoint x="670" y="300"/></Array></mxGeometry></mxCell>
        <mxCell id="m8" value="8. 200 OK {completed: false} (no Deprecation header)" style="endArrow=block;endFill=1;dashed=1;strokeColor=#9673a6;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="510" y="325"/><mxPoint x="110" y="325"/></Array></mxGeometry></mxCell>
        <!-- Phase 3: sunset - old client gets 410 -->
        <mxCell id="m9" value="9. GET /v1/tasks (stale client, not migrated)" style="endArrow=block;endFill=1;strokeColor=#b85450;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="110" y="390"/><mxPoint x="210" y="390"/></Array></mxGeometry></mxCell>
        <mxCell id="m10" value="10. v1 is sunset -- return 410 Gone" style="endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="210" y="415"/><mxPoint x="110" y="415"/></Array></mxGeometry></mxCell>
        <!-- Phase 4: v2 only -->
        <mxCell id="m11" value="11. POST /v2/tasks {title, ...} + X-Client-Id" style="endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="110" y="475"/><mxPoint x="210" y="475"/></Array></mxGeometry></mxCell>
        <mxCell id="m12" value="12. route to v2" style="endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="210" y="495"/><mxPoint x="510" y="495"/></Array></mxGeometry></mxCell>
        <mxCell id="m13" value="13. 201 Created {id, completed: false}" style="endArrow=block;endFill=1;dashed=1;strokeColor=#9673a6;" edge="1" parent="1"><mxGeometry as="geometry"><Array as="points"><mxPoint x="510" y="520"/><mxPoint x="110" y="520"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
