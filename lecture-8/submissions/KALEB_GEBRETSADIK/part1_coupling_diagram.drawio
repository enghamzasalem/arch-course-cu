<mxfile host="app.diagrams.net" version="22.0.0" type="device">
  <diagram id="D1" name="Coupling Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Clients Box -->
        <mxCell id="box_clients" value="Clients &amp; API Consumers" style="swimlane;whiteSpace=wrap;html=1;startSize=23;fillColor=#f5f5f5;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="180" height="260" as="geometry" />
        </mxCell>
        <mxCell id="c_web" value="Web SPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="box_clients">
          <mxGeometry x="20" y="40" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c_mobile" value="Mobile App" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="box_clients">
          <mxGeometry x="20" y="110" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c_partner" value="Partner Integration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="box_clients">
          <mxGeometry x="20" y="180" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- Gateway Box -->
        <mxCell id="box_gw" value="API Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="360" y="140" width="120" height="140" as="geometry" />
        </mxCell>

        <!-- Task Core Box -->
        <mxCell id="box_backend" value="Backend Services" style="swimlane;whiteSpace=wrap;html=1;startSize=23;fillColor=#f5f5f5;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="220" height="260" as="geometry" />
        </mxCell>
        
        <mxCell id="s_task" value="Task API Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="box_backend">
          <mxGeometry x="30" y="60" width="160" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="s_db" value="Task Database" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="box_backend">
          <mxGeometry x="50" y="160" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Notification Box outside swimlane -->
        <mxCell id="s_notif" value="Notification Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="620" y="380" width="220" height="40" as="geometry" />
        </mxCell>

        <!-- Edges -->
        
        <!-- Web to Gateway -->
        <mxCell id="e_1" value="Data / Temporal:&#10;Sync JSON Schema" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_web" target="box_gw">
          <mxGeometry x="-0.3" y="15" relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- Mobile to Gateway -->
        <mxCell id="e_2" value="Data / Deployment:&#10;Firm API Versioning Needs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_mobile" target="box_gw">
          <mxGeometry x="-0.3" y="20" relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- Partner to Gateway -->
        <mxCell id="e_3" value="Data Coupling:&#10;External Contract Stability" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_partner" target="box_gw">
          <mxGeometry x="-0.3" y="15" relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- Gateway to Task API -->
        <mxCell id="e_4" value="Spatial / Routing:&#10;Proxy Forwarding" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;" edge="1" parent="1" source="box_gw" target="s_task">
          <mxGeometry y="15" relative="1" as="geometry">
