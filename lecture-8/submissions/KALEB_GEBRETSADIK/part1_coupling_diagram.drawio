          <mxGeometry x="0.2" y="10" relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- Task API to Notif -->
        <mxCell id="e_6" value="Temporal / Control:&#10;Needs queue to reduce" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#FF9900;strokeWidth=2;" edge="1" parent="1" source="box_backend" target="s_notif">
          <mxGeometry x="0.1" y="-40" relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- Legend Box -->
