          <mxGeometry x="40" y="440" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="leg_solid" value="Coupled JSON / Flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="box_legend">
          <mxGeometry x="60" y="30" width="220" height="20" as="geometry" />
