        <mxCell id="e_p1b" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" edge="1" parent="swimlane_peak" source="p_ingress" target="p_api_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_p2" value="2 High Concurrency Cache Hit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" edge="1" parent="swimlane_peak" source="p_api_1" target="p_redis">
