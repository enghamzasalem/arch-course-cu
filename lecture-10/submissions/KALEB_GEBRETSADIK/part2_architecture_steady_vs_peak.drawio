<mxfile host="app.diagrams.net" version="22.0.0" type="device">
  <diagram id="steady-peak" name="Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Legend and Title block -->
        <mxCell id="legend_box" value="Title: CityBite Scalability (Steady vs Peak)&#10;Author: Kaleb Gebretsadik&#10;Date: 2026-04-24" style="text;html=1;strokeColor=#000000;fillColor=#f5f5f5;align=left;verticalAlign=middle;spacingLeft=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- Steady State Swimlane -->
        <mxCell id="swimlane_steady" value="Steady State (Low Traffic Afternoon)" style="swimlane;whiteSpace=wrap;html=1;startSize=23;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="480" height="600" as="geometry" />
        </mxCell>
        
        <!-- Steady State Components -->
        <mxCell id="s_ingress" value="K8s Ingress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="swimlane_steady">
          <mxGeometry x="180" y="50" width="120" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="s_api_1" value="Order API Pod 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="swimlane_steady">
          <mxGeometry x="180" y="140" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s_redis" value="Redis Cache" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="swimlane_steady">
          <mxGeometry x="40" y="240" width="80" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="s_queue" value="RabbitMQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="swimlane_steady">
          <mxGeometry x="340" y="250" width="100" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s_db_primary" value="Postgres Primary&#10;(Reads/Writes)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="swimlane_steady">
          <mxGeometry x="180" y="400" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s_worker_1" value="Notification Worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="swimlane_steady">
          <mxGeometry x="330" y="410" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- Steady State Edges -->
        <mxCell id="e_s1" value="1 HTTPS Request" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" edge="1" parent="swimlane_steady" source="s_ingress" target="s_api_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s2" value="2 Read Cache" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" edge="1" parent="swimlane_steady" source="s_api_1" target="s_redis">
