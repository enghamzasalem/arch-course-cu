        <mxCell id="e_s5" value="5 Process Async" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" edge="1" parent="swimlane_steady" source="s_queue" target="s_worker_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>


        <!-- Peak State Swimlane -->
        <mxCell id="swimlane_peak" value="Peak State (Friday Dinner Rush)" style="swimlane;whiteSpace=wrap;html=1;startSize=23;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="540" y="100" width="520" height="600" as="geometry" />
