        <mxCell id="p_worker_2" value="Notif Worker N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="swimlane_peak">
          <mxGeometry x="450" y="470" width="90" height="40" as="geometry" />
        </mxCell>

        <!-- Peak Edges -->
        <mxCell id="e_p1" value="1 HTTPS Surge" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" edge="1" parent="swimlane_peak" source="p_ingress" target="p_api_2">
          <mxGeometry relative="1" as="geometry" />
