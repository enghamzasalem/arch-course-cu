        <mxCell id="p_api_3" value="Order API Pod N (HPA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="swimlane_peak">
