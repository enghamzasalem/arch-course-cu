        <mxCell id="p_db_replica" value="Postgres Replica&#10;(Reads Only)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="swimlane_peak">
