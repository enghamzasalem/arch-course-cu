        <mxCell id="e_s3" value="3 Write Order" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" edge="1" parent="swimlane_steady" source="s_api_1" target="s_db_primary">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s4" value="4 Queue Async Event" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" edge="1" parent="swimlane_steady" source="s_api_1" target="s_queue">
