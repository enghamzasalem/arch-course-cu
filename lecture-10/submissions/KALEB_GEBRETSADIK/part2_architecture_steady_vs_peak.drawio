        </mxCell>
        
        <mxCell id="p_queue" value="RabbitMQ&#10;(Deep Queue Depth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="swimlane_peak">
          <mxGeometry x="370" y="250" width="130" height="40" as="geometry" />
