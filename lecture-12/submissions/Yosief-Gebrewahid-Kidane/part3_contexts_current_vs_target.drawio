        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n%% =========================\n%% LEFT SIDE — CURRENT\n%% =========================\nsubgraph LEFT[\&quot;Current State — Modular Monolith\&quot;]\n\nC[\&quot;Clients\&quot;]\n\nMONO[\&quot;CityBite Monolith\n- Orders\n- Payments\n- Notifications\n- Dispatch\n- Restaurants\&quot;]\n\nDB[\&quot;Shared PostgreSQL\&quot;]\n\nPAY_EXT[\&quot;Payment Gateway\&quot;]\nSMS_EXT[\&quot;SMS / Push Service\&quot;]\n\nC --&gt;|\&quot;1 HTTP Request\&quot;| MONO\nMONO --&gt;|\&quot;2 SQL Queries\&quot;| DB\nMONO --&gt;|\&quot;3 Payment Call\&quot;| PAY_EXT\nMONO --&gt;|\&quot;4 Notification Call\&quot;| SMS_EXT\n\nend\n\n%% =========================\n%% RIGHT SIDE — TARGET\n%% =========================\nsubgraph RIGHT[\&quot;Target State — Bounded Contexts + Events\&quot;]\n\nC2[\&quot;Clients\&quot;]\n\nGW[\&quot;API Gateway / BFF\&quot;]\n\nORDER[\&quot;Order Service\&quot;]\nPAY[\&quot;Payment Service\&quot;]\nNOTIF[\&quot;Notification Service\&quot;]\nDISP[\&quot;Dispatch Service\&quot;]\nREST[\&quot;Restaurant Service\&quot;]\n\nORDER_DB[\&quot;Orders DB\&quot;]\nPAY_DB[\&quot;Payments DB\&quot;]\nREST_DB[\&quot;Restaurant DB\&quot;]\n\nQUEUE[\&quot;Event Bus (Kafka / SQS)\&quot;]\n\nPAY_EXT2[\&quot;Payment Gateway\&quot;]\nSMS_EXT2[\&quot;SMS / Push\&quot;]\nMAPS[\&quot;Maps API\&quot;]\n\nC2 --&gt;|\&quot;1 Request\&quot;| GW\n\nGW --&gt;|\&quot;2 Sync\&quot;| ORDER\nGW --&gt;|\&quot;3 Sync\&quot;| REST\n\nORDER --&gt;|\&quot;4 Publish OrderPlaced Event\&quot;| QUEUE\n\nQUEUE --&gt; PAY\nQUEUE --&gt; NOTIF\nQUEUE --&gt; DISP\n\nORDER --&gt; ORDER_DB\nPAY --&gt; PAY_DB\nREST --&gt; REST_DB\n\nPAY --&gt;|\&quot;5 Charge\&quot;| PAY_EXT2\nNOTIF --&gt;|\&quot;6 Notify\&quot;| SMS_EXT2\nDISP --&gt;|\&quot;7 Route\&quot;| MAPS\n\nend\n\n%% =========================\n%% VISUAL HINT\n%% =========================\nLEFT --- RIGHT&quot;&#xa;}" id="g8hoV9OcfnwCRAMI-zxJ-1">
